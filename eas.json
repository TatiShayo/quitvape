{
  "cli": {
    "version": ">= 8.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "resourceClass": "m1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "resourceClass": "m1"
      }
    },
    "production": {
      "android": {
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "resourceClass": "m1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "<NEEDS HUMAN: app id from App Store Connect>"
      },
      "android": {
        "serviceAccount": "<NEEDS HUMAN: Google Play Console service account json>"
      }
    }
  }
}
