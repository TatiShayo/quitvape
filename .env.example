# QuitVape environment variables — copy to .env and fill in real values.
# .env is gitignored. EXPO_PUBLIC_* values are bundled into the app (public by design)
# and must NEVER hold a true secret. The Anthropic key is a server-only edge secret.
#
# Rotation: rotate any leaked EXPO_PUBLIC_* key in its provider dashboard and rebuild
# the app. Rotate ANTHROPIC_API_KEY via Supabase Edge Function secrets (no app rebuild).

# --- Supabase (anonymous auth, community feed, craving analytics) ---
# Anon key is safe to ship (RLS enforces access). URL + anon key are public by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- RevenueCat (IAP / subscriptions / paywall) ---
# Public SDK keys per platform. Safe to ship. Missing -> dev mock auto-grants entitlement.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- PostHog (product analytics) ---
# Public project key. NEVER put quit/relapse/craving data in event properties.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (error monitoring) ---
# DSN is public. Scrub request bodies; no PII in events.
EXPO_PUBLIC_SENTRY_DSN=

# --- Anthropic (AI coach) — SERVER SECRET ONLY ---
# This lives in Supabase Edge Function secrets, NOT in the app bundle. Listed here only
# so the human knows it is required. Do NOT prefix with EXPO_PUBLIC_.
# ANTHROPIC_API_KEY=
